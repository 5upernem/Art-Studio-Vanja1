<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFF8F0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#F5E6D3;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="800" height="600" fill="url(#bg2)"/>

  <!-- Watercolor circles -->
  <circle cx="200" cy="200" r="90" fill="rgba(30, 136, 229, 0.15)"/>
  <circle cx="600" cy="400" r="110" fill="rgba(123, 31, 162, 0.12)"/>
  <circle cx="450" cy="280" r="70" fill="rgba(197, 165, 165, 0.18)"/>
  <circle cx="150" cy="450" r="85" fill="rgba(124, 179, 66, 0.1)"/>

  <!-- Icon - Video Camera -->
  <g transform="translate(350, 250)">
    <circle cx="50" cy="50" r="60" fill="rgba(124, 179, 66, 0.9)"/>
    <rect x="20" y="35" width="40" height="30" fill="white" rx="3"/>
    <circle cx="40" cy="50" r="8" fill="rgba(124, 179, 66, 0.9)"/>
    <polygon points="60,42 75,35 75,65 60,58" fill="white"/>
    <rect x="30" y="25" width="5" height="8" fill="white"/>
    <rect x="45" y="25" width="5" height="8" fill="white"/>
  </g>

  <text x="400" y="400" font-family="Kalam, cursive" font-size="36" fill="#2C1810" text-anchor="middle" font-weight="bold">АРТ СТУДИО ВАЊА</text>
  <text x="400" y="440" font-family="Poppins, sans-serif" font-size="24" fill="#666666" text-anchor="middle">Креативни догађаји</text>
</svg>
