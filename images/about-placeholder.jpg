<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F5E6D3;stop-opacity:1" />
      <stop offset="25%" style="stop-color:#FFF8F0;stop-opacity:1" />
      <stop offset="75%" style="stop-color:#F5E6D3;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E8D5C4;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="800" height="600" fill="url(#bg4)"/>

  <!-- Watercolor effect -->
  <circle cx="150" cy="150" r="110" fill="rgba(255, 215, 0, 0.15)"/>
  <circle cx="650" cy="150" r="100" fill="rgba(124, 179, 66, 0.12)"/>
  <circle cx="150" cy="450" r="105" fill="rgba(229, 57, 53, 0.1)"/>
  <circle cx="650" cy="450" r="95" fill="rgba(30, 136, 229, 0.13)"/>
  <circle cx="400" cy="300" r="140" fill="rgba(197, 165, 165, 0.18)"/>

  <!-- Central logo-like element -->
  <circle cx="400" cy="280" r="80" fill="rgba(197, 165, 165, 0.8)"/>
  <text x="400" y="295" font-family="Kalam, cursive" font-size="64" fill="white" text-anchor="middle" font-weight="bold">V</text>

  <!-- Text -->
  <text x="400" y="420" font-family="Kalam, cursive" font-size="42" fill="#2C1810" text-anchor="middle" font-weight="bold">АРТ СТУДИО ВАЊА</text>
  <text x="400" y="460" font-family="Poppins, sans-serif" font-size="20" fill="#666666" text-anchor="middle">Креативни центар за визуелне уметности</text>
  <text x="400" y="490" font-family="Poppins, sans-serif" font-size="18" fill="#999999" text-anchor="middle">Радионице • Курсеви • Пројекти • Изложбе</text>
</svg>
