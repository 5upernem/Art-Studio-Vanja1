<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F5E6D3;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#FFF8F0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#F5E6D3;stop-opacity:1" />
    </linearGradient>
  </defs>

  <rect width="800" height="600" fill="url(#bg3)"/>

  <!-- Watercolor circles -->
  <circle cx="180" cy="180" r="95" fill="rgba(229, 57, 53, 0.15)"/>
  <circle cx="620" cy="420" r="105" fill="rgba(255, 215, 0, 0.12)"/>
  <circle cx="400" cy="500" r="75" fill="rgba(30, 136, 229, 0.1)"/>
  <circle cx="650" cy="180" r="88" fill="rgba(197, 165, 165, 0.16)"/>

  <!-- Icon - Easel/Canvas -->
  <g transform="translate(350, 250)">
    <circle cx="50" cy="50" r="60" fill="rgba(229, 57, 53, 0.9)"/>
    <rect x="25" y="30" width="50" height="35" fill="white" rx="2"/>
    <line x1="35" y1="65" x2="30" y2="80" stroke="white" stroke-width="3"/>
    <line x1="65" y1="65" x2="70" y2="80" stroke="white" stroke-width="3"/>
    <line x1="28" y1="80" x2="72" y2="80" stroke="white" stroke-width="3"/>
  </g>

  <text x="400" y="400" font-family="Kalam, cursive" font-size="36" fill="#2C1810" text-anchor="middle" font-weight="bold">АРТ СТУДИО ВАЊА</text>
  <text x="400" y="440" font-family="Poppins, sans-serif" font-size="24" fill="#666666" text-anchor="middle">Уметничке радионице</text>
</svg>
